def quiz(student_name):
    score = 0

    questions = [
        {
            "question": "1. Who created Python?",
            "choices": [
                "A. Bill Gates",
                "B. Guido van Rossum",
                "C. Mark Zuckerberg",
                "D. Steve Jobs"
            ],
            "answer": "B"
        },
        {
            "question": "2. What is used to display text in Python?",
            "choices": [
                "A. input()",
                "B. print()",
                "C. display()",
                "D. show()"
            ],
            "answer": "B"
        },
        {
            "question": "3. Which symbol is used for multiplication?",
            "choices": [
                "A. +",
                "B. -",
                "C. *",
                "D. /"
            ],
            "answer": "C"
        },
        {
            "question": "4. What is the correct way to create a variable?",
            "choices": [
                "A. name = 'Juan'",
                "B. variable name",
                "C. print = name",
                "D. input name"
            ],
            "answer": "A"
        },
        {
            "question": "5. What is the output of 10 + 5?",
            "choices": [
                "A. 10",
                "B. 15",
                "C. 20",
                "D. 5"
            ],
            "answer": "B"
        }
    ]

    line()
    print("                  PYTHON QUIZ")
    line()
    print("Student Name:", student_name)
    print("There are 5 questions.")
    print("Choose the correct letter: A, B, C, or D.")
    line()

    for item in questions:
        print()
        print(item["question"])

        for choice in item["choices"]:
            print(choice)

        while True:
            answer = input("Your Answer: ").upper().strip()

            if answer in ["A", "B", "C", "D"]:
                break
            else:
                print("Invalid answer! Please choose A, B, C, or D.")

        if answer == item["answer"]:
            print("Correct! Good job!")
            score += 1
        else:
            print("Wrong answer!")
            print("Correct Answer:", item["answer"])

    line()
    print("                 QUIZ RESULT")
    line()
    print("Student Name:", student_name)
    print("Your Score:", score, "/ 5")

    if score == 5:
        print("Excellent! Perfect Score!")
    elif score >= 3:
        print("Good Job! Keep Learning!")
    else:
        print("Keep Practicing! You Can Do It!")

    line()


